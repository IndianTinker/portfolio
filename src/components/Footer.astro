---
const year = new Date().getFullYear();
---

<footer class="footer wrap">
  <div class="footer__inner">
    <p class="footer__meta">© {year} Rohit Gupta</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: 3rem;
  }
  .footer__inner {
    border-top: 2px solid var(--line-strong); /* bt bw1 in the original */
    padding-top: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .footer p {
    margin: 0;
    max-width: 34rem;
  }
  .i {
    font-style: italic;
  }
</style>
