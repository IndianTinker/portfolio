---
// Image-trail hero — vanilla port of fancycomponents.dev's ImageTrail.
// Moving the cursor pops project covers one by one along the path: each
// pops in (scale+opacity via WAAPI), drifts toward the lerped cursor while
// alive, pops out, and its element is recycled. The trail sits UNDER the
// heading, which is near-white + mix-blend-mode:difference — glyphs read as
// ink over the paper and invert to each cover's complement where one
// passes beneath. Covers are decode-gated so nothing gray ever shows.
interface OrbitImage {
  src: string;
  title: string;
}
interface Props {
  greeting: string;
  intro: string;
  images: OrbitImage[];
}
const { greeting, intro, images } = Astro.props;
const ring = images.slice(0, 12);

// Heading split at the sentence boundary: two lines on desktop.
const s = intro.split(/(?<=\.)\s+/);
const line1 = `${greeting} ${s[0] ?? ''}`.trim();
const line2 = s.slice(1).join(' ');
---

<section class="hero" data-hero>
  <div class="hero__trail" data-trail aria-hidden="true">
    {
      ring.map((img) => (
        <div class="trail__item">
          <img src={img.src} alt="" loading="eager" decoding="async" />
        </div>
      ))
    }
  </div>

  <div class="hero__center">
    <h1 class="hero__title">
      {line1}{' '}
      {line2 ? <><br class="hero__br" />{line2}</> : ''}
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: min(88vh, 46rem);
    padding-block: clamp(3rem, 9vw, 7rem);
    overflow: hidden;
  }

  /* Trail UNDER the heading — the blend needs the covers as backdrop. */
  .hero__trail {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .hero__trail.is-ready {
    opacity: 1;
  }
  .trail__item {
    position: absolute;
    top: 0;
    left: 0;
    display: none;
    width: clamp(110px, 13vw, 190px);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    /* transform is driven by JS (translate3d + rotate); the inner img
       carries the WAAPI scale/opacity keyframes so they never fight */
    will-change: transform;
  }
  .trail__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Heading is the BOTTOM layer — covers pop over it and take it over. */
  .hero__center {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-inline: clamp(2.5rem, 8vw, 9rem);
    max-width: none;
  }
  .hero__title {
    color: var(--ink);
    font-family: var(--font-display);
    letter-spacing: 0;
    font-weight: 400;
    font-size: clamp(1.6rem, 3.3vw, 2.65rem);
    line-height: 1.32;
    text-wrap: balance;
  }
  /* On small screens the hard break fights natural wrapping — drop it. */
  @media (max-width: 48rem) {
    .hero__br {
      display: none;
    }
    /* text up top, covers get the room underneath — no overlap */
    .hero {
      align-content: start;
      place-items: start center;
    }
    .hero__center {
      padding-inline: 1.25rem;
    }
    .trail__item {
      width: min(76vw, 320px);
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const trail = hero?.querySelector<HTMLElement>('[data-trail]');

  if (hero && trail && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = [...trail.querySelectorAll<HTMLElement>('.trail__item')];
    const THRESHOLD = 60; // px of travel between pops (fancy: threshold)

    const last = { x: -1e4, y: -1e4 };
    let idx = 0;
    let ready = false;
    const MAX_ALIVE = 4; // rolling buffer of covers on screen at once
    const alive: HTMLElement[] = [];

    const retire = (el: HTMLElement) => {
      const img = el.firstElementChild;
      if (!img) return;
      img.getAnimations().forEach((a) => a.cancel());
      const out = img.animate(
        [
          { scale: '1', opacity: '1' },
          { scale: '0.5', opacity: '0' },
        ],
        { duration: 220, easing: 'ease-out' }
      );
      out.onfinish = () => {
        el.style.display = 'none';
      };
    };

    const spawn = (x: number, y: number) => {
      const el = items[idx % items.length];
      idx++;
      el.firstElementChild?.getAnimations().forEach((a) => a.cancel());
      el.style.display = 'block';
      el.style.zIndex = String(idx % 9999);
      // anchored: the cover stamps down here and does not move again
      el.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%) rotate(${Math.round((Math.random() * 2 - 1) * 9)}deg)`;
      const img = el.firstElementChild;
      // pop in and HOLD — a cover only leaves when the buffer evicts it
      img?.animate(
        [
          { scale: '0', opacity: '0' },
          { scale: '1', opacity: '1' },
        ],
        { duration: 260, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)', fill: 'both' }
      );
      alive.push(el);
      while (alive.length > MAX_ALIVE) {
        const old = alive.shift();
        if (old) retire(old);
      }
    };

    hero.addEventListener('pointermove', (e) => {
      if (!ready || mqMobile.matches) return;
      const r = hero.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      if (Math.hypot(x - last.x, y - last.y) < THRESHOLD) return;
      last.x = x;
      last.y = y;
      spawn(x, y);
    });

    // --- mobile: concentric reveal from the centre ------------------------
    // Covers tick in one by one, each bigger than the last, stacked behind
    // the text — 40% → 100% at the 6th, easing back down after.
    const mqMobile = window.matchMedia('(max-width: 48rem)');
    const MOBILE_SIZES = [0.4, 0.52, 0.64, 0.76, 0.88, 1, 0.9, 0.8, 0.72, 0.64, 0.58, 0.52];
    const MOBILE_STEP = 900; // ms each cover holds before the next takes over
    let mTimer: ReturnType<typeof setInterval> | null = null;
    let mCurrent: HTMLElement | null = null;
    let mIdx = 0;

    const mobileOut = (el: HTMLElement) => {
      const img = el.firstElementChild;
      if (!img) return;
      const out = img.animate(
        [
          { scale: '1', opacity: '1' },
          { scale: '0.6', opacity: '0' },
        ],
        { duration: 300, easing: 'ease-out', fill: 'both' }
      );
      out.onfinish = () => {
        el.style.display = 'none';
      };
    };

    const mobileStep = () => {
      if (!mqMobile.matches) return;
      const r = hero.getBoundingClientRect();
      const t = (hero.querySelector('.hero__center') as HTMLElement).getBoundingClientRect();
      const cx = r.width / 2;
      // centre of whatever room is left under the heading
      const cy = (t.bottom - r.top + r.height) / 2;
      const el = items[mIdx % items.length];
      const size = MOBILE_SIZES[mIdx % MOBILE_SIZES.length];
      mIdx++;
      if (mCurrent && mCurrent !== el) mobileOut(mCurrent);
      mCurrent = el;
      el.getAnimations().forEach((a) => a.cancel());
      el.style.display = 'block';
      el.style.transform = `translate3d(${cx}px, ${cy}px, 0) translate(-50%, -50%) scale(${size})`;
      el.firstElementChild?.animate(
        [
          { scale: '0.6', opacity: '0' },
          { scale: '1', opacity: '1' },
        ],
        { duration: 320, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)', fill: 'both' }
      );
    };

    const setMobile = (on: boolean) => {
      if (mTimer) clearInterval(mTimer);
      mTimer = null;
      mCurrent = null;
      mIdx = 0;
      items.forEach((el) => {
        el.getAnimations().forEach((a) => a.cancel());
        el.firstElementChild?.getAnimations().forEach((a) => a.cancel());
        el.style.display = 'none';
      });
      if (!on) return;
      mobileStep();
      mTimer = setInterval(mobileStep, MOBILE_STEP);
    };
    setMobile(mqMobile.matches);
    mqMobile.addEventListener('change', (e) => setMobile(e.matches));

    // Progressive reveal — arm as soon as the first images decode.
    let loadedCount = 0;
    const MIN_READY = 3; // spawn after just 3 covers decode
    const markReady = () => {
      if (ready) return;
      loadedCount++;
      if (loadedCount >= MIN_READY) {
        trail.classList.add('is-ready');
        ready = true;
      }
    };
    items.forEach((el) => {
      const img = el.querySelector('img');
      if (!img) { markReady(); return; }
      if (img.complete && img.naturalWidth) { markReady(); return; }
      img.addEventListener('load', markReady, { once: true });
      img.addEventListener('error', markReady, { once: true });
    });
  }
</script>
