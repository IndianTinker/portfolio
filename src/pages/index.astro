---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SelectedCard from '../components/SelectedCard.astro';
import { reader } from '../lib/reader';
import { getProjects, coverThumb } from '../lib/projects';

const home = await reader.singletons.home.read();
const greeting = home?.greeting ?? 'Hello!';
const intro =
  home?.intro ??
  'I am a designer and an engineer. I like to build things for creative enquiry.';
const heading = `${greeting} ${intro}`;

const projects = await getProjects();

// Hero ring: every project that has a cover, in list order.
const ring = projects
  .map((p) => ({ src: coverThumb(p.entry.media), title: p.entry.title }))
  .filter((x): x is { src: string; title: string } => Boolean(x.src));

// Featured strip: first 5 featured projects by manual order.
const featured = projects.filter((p) => p.entry.featured).slice(0, 5);
---

<Base>
  <Hero heading={heading} images={ring} />

  <section class="wrap">
    <h2 class="eyebrow section-head">Selected Projects</h2>
    <div class="selected-row">
      {featured.map((project) => <SelectedCard project={project} />)}
    </div>
  </section>
</Base>

<style>
  .section-head {
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-strong);
    margin: 0 0 1.25rem;
  }
  .selected-row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72vw, 20rem);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
  }
  .selected-row > :global(a) {
    scroll-snap-align: start;
  }
  @media (min-width: 60rem) {
    .selected-row {
      grid-auto-flow: row;
      grid-auto-columns: unset;
      grid-template-columns: repeat(5, 1fr);
      overflow-x: visible;
      scroll-snap-type: none;
    }
  }
</style>
