---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TopBubble from '../components/TopBubble';
import { reader } from '../lib/reader';
import { getProjects } from '../lib/projects';

const home = await reader.singletons.home.read();
const greeting = home?.greeting ?? 'Hello!';
const intro =
  home?.intro ??
  'I am a designer and an engineer. I like to build things for creative enquiry.';

const projects = await getProjects();
const featured = projects.filter((p) => p.entry.featured);
const shown = featured.length ? featured : projects.slice(0, 6);
---

<Base>
  <TopBubble greeting={greeting} intro={intro} client:load />

  <section class="wrap">
    <h2 class="section-head rule eyebrow">Selected Projects</h2>
    <div class="list">
      {shown.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Base>

<style>
  .section-head {
    font-size: var(--f3); /* f3, tracked */
    padding-top: 0.75rem;
    margin: 0 0 1rem;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
</style>
