---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SelectedCard from '../components/SelectedCard.astro';
import { reader } from '../lib/reader';
import { getProjects, coverThumb } from '../lib/projects';

const home = await reader.singletons.home.read();
const greeting = home?.greeting ?? 'Hello!';
const intro =
  home?.intro ??
  'I am a designer and an engineer. I like to build things for creative enquiry.';

const projects = await getProjects();

// Hero ring: every project that has a cover, in list order.
const ring = projects
  .map((p) => ({ src: coverThumb(p.entry.media), title: p.entry.title }))
  .filter((x): x is { src: string; title: string } => Boolean(x.src));

// Featured strip: first 5 featured projects by manual order.
const featured = projects.filter((p) => p.entry.featured).slice(0, 5);

// Upcoming / in-progress work surfaces under the selected strip.
const upcoming = projects.filter(
  (p) => p.entry.status === 'Upcoming' || p.entry.status === 'In progress'
);

const testimonials = home?.testimonials ?? [];
const companies = home?.companies ?? [];
---

<Base>
    <Hero greeting={greeting} intro={intro} images={ring} />

  {
    companies.length > 0 && (
      <section class="wrap">
        <h2 class="eyebrow section-head">Companies & Collaborators</h2>
        <ul class="logos">
          {companies.map((c) => (
            <li class="logos__item">
              {c.url ? (
                <a href={c.url} target="_blank" rel="noopener">
                  <img src={c.logo} alt={c.name} class="logos__img" loading="lazy" />
                </a>
              ) : (
                <img src={c.logo} alt={c.name} class="logos__img" loading="lazy" />
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="wrap">
    <h2 class="eyebrow section-head">Selected Projects</h2>
    <div class="selected-row">
      {featured.map((project) => <SelectedCard project={project} />)}
    </div>
  </section>

  {
    upcoming.length > 0 && (
      <section class="wrap">
        <h2 class="eyebrow section-head">Upcoming Projects</h2>
        <ul class="upcoming">
          {upcoming.map((p) => (
            <li class="upcoming__row">
              <span class="upcoming__status tnum">{p.entry.status}</span>
              <a href={`/projects/${p.slug}`} class="upcoming__title link-underline">
                {p.entry.title}
              </a>
              {p.entry.summary && <span class="upcoming__brief">{p.entry.summary}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    testimonials.length > 0 && (
      <section class="wrap">
        <h2 class="eyebrow section-head">Testimonials</h2>
        <div class="quotes">
          {testimonials.map((t) => (
            <figure class="quote">
              <blockquote class="quote__text">“{t.quote}”</blockquote>
              <figcaption class="quote__cite">
                {t.url ? (
                  <a href={t.url} target="_blank" rel="noopener" class="prose-link">
                    {t.name}
                  </a>
                ) : (
                  t.name
                )}
                {t.role && <span class="quote__role"> — {t.role}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .section-head {
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-strong);
    margin: 0 0 1.25rem;
  }
  .selected-row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72vw, 20rem);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
  }
  .selected-row > :global(a) {
    scroll-snap-align: start;
  }
  @media (min-width: 48rem) {
    .selected-row {
      grid-auto-flow: row;
      grid-auto-columns: unset;
      grid-template-columns: repeat(3, 1fr);
      overflow-x: visible;
      scroll-snap-type: none;
    }
  }
  @media (min-width: 60rem) {
    .selected-row {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  /* Upcoming / in-progress — dense rows, status pill in the tag style. */
  .upcoming {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .upcoming__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }
  .upcoming__status {
    font-family: var(--font-display);
    font-size: var(--f6);
    background: var(--surface);
    padding: 0.15rem 0.5rem;
  }
  .upcoming__title {
    font-size: var(--f5);
  }
  .upcoming__brief {
    flex-basis: 100%;
    color: var(--ink-soft);
    font-size: var(--f6);
  }

  /* Testimonials — quiet quote cards on hairlines. */
  .quotes {
    display: grid;
    gap: 0;
  }
  @media (min-width: 48rem) {
    .quotes {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
  }
  .quote {
    margin: 0;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .quote__text {
    margin: 0 0 0.75rem;
    font-size: var(--f3);
    line-height: 1.35;
    text-wrap: pretty;
  }
  .quote__cite {
    font-size: var(--f6);
    color: var(--ink-soft);
  }
  .quote__cite a {
    color: var(--link); /* light-purple, dims on hover — rich-text link voice */
  }
  .quote__cite a:hover {
    opacity: 0.5;
  }

  /* Companies logo strip. */
  .logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .logos__item {
    flex: 0 0 auto;
  }
  .logos__img {
    height: 2rem;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.5;
    transition: opacity 0.2s ease, filter 0.2s ease;
  }
  .logos__item:hover .logos__img {
    filter: grayscale(0);
    opacity: 1;
  }
</style>
