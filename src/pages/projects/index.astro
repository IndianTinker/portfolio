---
import Base from '../../layouts/Base.astro';
import SelectedCard from '../../components/SelectedCard.astro';
import { getProjects, coverThumb, startYear, score } from '../../lib/projects';

const projects = await getProjects();
// Top row: first 5 featured projects by manual order.
const selected = projects.filter((p) => p.entry.featured).slice(0, 5);

// The index below the selected work runs newest-first, ignoring the manual order.
const index = [...projects].sort(
  (a, b) => startYear(b.entry.year) - startYear(a.entry.year)
);

// Sort dimensions — each chip toggles asc/desc; empty state = manual order.
const SORTS = [
  { key: 'year', label: 'Year' },
  { key: 'difficulty', label: 'Difficulty' },
  { key: 'fun', label: 'Fun' },
  { key: 'popularity', label: 'Popularity' },
  { key: 'duration', label: 'Duration' },
];

// Each bucket doubles as a filter and as a thing someone can commission.
const BUCKETS = [
  { name: 'Installations & Exhibits', cta: 'Planning an exhibit or an interactive installation?' },
  { name: 'Physical Products & Prototypes', cta: 'Need a physical product prototyped and tested?' },
  { name: 'Speculative & Critical', cta: 'Want a speculative piece to provoke a conversation?' },
  { name: 'Digital Products & Platforms', cta: 'Building a digital product or platform?' },
  { name: 'Generative & Data Visuals', cta: 'Have data or a story that needs a visual form?' },
];
const EMAIL = 'indiantinker@gmail.com';
---

<Base title="Projects — Rohit Gupta">
  <section class="wrap">
    <h1 class="page-head">Projects</h1>

    {
      selected.length > 0 && (
        <>
          <h2 class="eyebrow section-head">Selected work</h2>
          <div class="selected-row">
            {selected.map((project) => (
              <SelectedCard project={project} />
            ))}
          </div>
        </>
      )
    }

    <h2 class="eyebrow section-head section-head--index">All work</h2>

    <div class="filters" role="group" aria-label="Filter projects by kind of work">
      <span class="filters__label">Domain</span>
      <div class="filters__chips">
        <button class="chip is-active" data-filter="all" aria-pressed="true">
          All <span class="chip__n tnum">{index.length}</span>
        </button>
        {
          BUCKETS.map((b) => (
            <button class="chip" data-filter={b.name} aria-pressed="false">
              {b.name}{' '}
              <span class="chip__n tnum">{index.filter((p) => p.entry.category === b.name).length}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="filters" role="group" aria-label="Sort projects">
      <span class="filters__label">Sort</span>
      <div class="filters__chips">
        {
          SORTS.map((s) => (
            <button class="chip chip--sort" data-sort={s.key} aria-pressed="false">
              {s.label} <span class="chip__dir" aria-hidden="true" />
            </button>
          ))
        }
        <button class="chip chip--random" id="random-btn" type="button">Random ↝</button>
      </div>
    </div>

    <ul class="index" id="index">
      {
        index.map((p) => {
          const thumb = coverThumb(p.entry.media);
          return (
            <li
              class="row"
              data-cat={p.entry.category}
              data-year={startYear(p.entry.year)}
              data-difficulty={score(p.entry, 'difficulty')}
              data-fun={score(p.entry, 'fun')}
              data-popularity={score(p.entry, 'popularity')}
              data-duration={score(p.entry, 'durationWeeks')}
            >
              <a href={`/projects/${p.slug}`} class="row__link" data-image={thumb ?? ''}>
                {thumb && <img class="row__thumb" src={thumb} alt="" loading="lazy" />}
                <div class="row__text">
                  <span class="row__year tnum">{p.entry.year}</span>
                  <span class="row__title">{p.entry.title}</span>
                  <span class="row__client">{p.entry.client}</span>
                  {p.entry.summary && <span class="row__brief">{p.entry.summary}</span>}
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="cta">
      <p class="cta__text" data-cta="all">Working on something in this territory?</p>
      {
        BUCKETS.map((b) => (
          <p class="cta__text" data-cta={b.name} hidden>
            {b.cta}
          </p>
        ))
      }
      <a href={`mailto:${EMAIL}`} class="link-underline cta__link">Let’s talk — {EMAIL}</a>
    </div>
  </section>

  <img
    id="row-cursor-image"
    src=""
    alt=""
    class="row-cursor"
    aria-hidden="true"
  />
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filters .chip[data-filter]');
  const rows = document.querySelectorAll<HTMLLIElement>('.row');
  const ctas = document.querySelectorAll<HTMLParagraphElement>('.cta__text');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter!;

      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', String(on));
      });
      rows.forEach((r) => {
        r.hidden = filter !== 'all' && r.dataset.cat !== filter;
      });
      ctas.forEach((p) => {
        p.hidden = p.dataset.cta !== filter;
      });
    });
  });
</script>

<script>
  // Sort chips: click to sort asc, click again to flip desc. Each <li> carries
  // numeric data-* attrs emitted at build time; ordering happens by re-appending.
  const sortChips = document.querySelectorAll<HTMLButtonElement>('.chip--sort');
  const indexList = document.getElementById('index');

  if (indexList) {
    const rows = Array.from(indexList.children) as HTMLLIElement[];
    let active: string | null = null;
    let dir = 1;

    // Remember the build-time order for the reset path.
    rows.forEach((r, i) => (r.dataset.i = String(i)));

    const apply = () => {
      if (!active) {
        // Empty state = the build-time (newest-first) order.
        rows.sort((a, b) => Number(a.dataset.i) - Number(b.dataset.i));
      } else {
        rows.sort((a, b) => (Number(a.dataset[active!]) - Number(b.dataset[active!])) * dir);
      }
      rows.forEach((r) => indexList.appendChild(r));
    };

    sortChips.forEach((chip, i) => {
      chip.addEventListener('click', () => {
        const key = chip.dataset.sort!;
        if (active === key) {
          dir *= -1; // same dimension — flip direction
        } else {
          active = key;
          dir = 1;
        }
        sortChips.forEach((c) => {
          const on = c === chip && active === key;
          c.classList.toggle('is-active', on);
          c.setAttribute('aria-pressed', String(on));
          const arrow = c.querySelector<HTMLElement>('.chip__dir');
          if (arrow) arrow.textContent = on ? (dir === 1 ? '↑' : '↓') : '';
        });
        apply();
      });
    });
  }

  // Random project — jumps to one of the currently visible rows.
  document.getElementById('random-btn')?.addEventListener('click', () => {
    const visible = Array.from(document.querySelectorAll<HTMLLIElement>('.row')).filter(
      (r) => !r.hidden
    );
    if (visible.length === 0) return;
    const pick = visible[Math.floor(Math.random() * visible.length)];
    const link = pick.querySelector<HTMLAnchorElement>('a.row__link');
    if (link) window.location.href = link.href;
  });
</script>

<script>
  // Cursor-following cover preview on the all-work list (Studio-021 port).
  // Desktop pointers only — touch devices use the inline thumbs.
  const cursorImage = document.getElementById('row-cursor-image') as HTMLImageElement;
  const indexList = document.getElementById('index');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');

  if (cursorImage && indexList && canHover.matches) {
    let shown = false;

    const move = (e: MouseEvent) => {
      cursorImage.style.top = `${e.clientY}px`;
      cursorImage.style.left = `${e.clientX}px`;
    };
    document.addEventListener('mousemove', move, { passive: true });

    indexList.querySelectorAll<HTMLAnchorElement>('.row__link').forEach((link) => {
      link.addEventListener('mouseenter', () => {
        const src = link.getAttribute('data-image');
        if (!src) return;
        cursorImage.src = src;
        shown = true;
        cursorImage.classList.add('is-on');
      });
      link.addEventListener('mouseleave', () => {
        shown = false;
        cursorImage.classList.remove('is-on');
      });
    });

    // Fade out when the pointer leaves the list entirely.
    indexList.addEventListener('mouseleave', () => {
      shown = false;
      cursorImage.classList.remove('is-on');
    });

    // Preload covers just before the list scrolls into view.
    const preload = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          indexList!
            .querySelectorAll<HTMLAnchorElement>('.row__link')
            .forEach((link) => {
              const src = link.getAttribute('data-image');
              if (src) {
                const img = new Image();
                img.src = src;
              }
            });
          preload.disconnect();
        }
      },
      { rootMargin: '200px' }
    );
    preload.observe(indexList);

    // Safety: if a row is clicked/navigated, drop the preview.
    document.addEventListener('pagehide', () => cursorImage.classList.remove('is-on'));
  }
</script>

<style>
  .page-head {
    font-size: var(--f3); /* f3 (mobile) */
    line-height: 1.25;
    margin: 0 0 clamp(1.5rem, 5vw, 3rem);
    padding-top: 2rem; /* 32px above the page title */
  }
  @media (min-width: 30em) {
    .page-head {
      font-size: var(--f-sub); /* f-subheadline-ns, matching About */
    }
  }
  .section-head {
    margin: 0 0 1.5rem;
    padding-top: 1rem;
    border-top: 2px solid var(--line-strong);
  }
  .section-head--index {
    margin-top: clamp(3rem, 8vw, 5rem);
  }
  /* Top row of 5 selected projects: scroll-snap strip on mobile,
     5-up grid from small-desktop up. */
  .selected-row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72vw, 20rem);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
  }
  .selected-row > :global(a) {
    scroll-snap-align: start;
  }
  @media (min-width: 48rem) {
    .selected-row {
      grid-auto-flow: row;
      grid-auto-columns: unset;
      grid-template-columns: repeat(3, 1fr);
      overflow-x: visible;
      scroll-snap-type: none;
    }
  }
  @media (min-width: 60rem) {
    .selected-row {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  /* Floating cursor-follow preview (desktop hover only). */
  .row-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 300px;
    height: 200px;
    object-fit: cover;
    object-position: top;
    pointer-events: none;
    z-index: 50;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
  }
  .row-cursor.is-on {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  /* Filter/sort rows — grey DOMAIN/SORT kicker in its own column, the chips
     in their own column where they wrap onto more rows to stay fully visible. */
  .filters {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(0.9rem, 2vw, 1.75rem);
    row-gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .filters__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  @media (max-width: 30em) {
    .filters {
      grid-template-columns: 1fr; /* stack the label above the scrolling strip */
      row-gap: 0.5rem;
    }
  }
  .chip {
    font: inherit;
    font-size: var(--f6);
    cursor: pointer;
    white-space: nowrap; /* one line per chip — the column scrolls instead */
    flex: none;
    padding: 0.4rem 0.75rem;
    border: 1px solid transparent;
    background: var(--surface);
    color: var(--ink);
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .chip:hover {
    border-color: var(--line-strong);
  }
  .chip.is-active {
    background: var(--ink);
    color: #fff;
  }
  /* Domain filter chips speak the same mono voice as the sort row: outlined
     box, Departure Mono label, count in a black rounded-full pill. */
  .chip[data-filter] {
    font-family: var(--font-display);
    background: transparent;
    border-color: var(--line);
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .chip[data-filter]:hover {
    border-color: var(--line-strong);
  }
  .chip[data-filter].is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .chip__n {
    display: inline-block; /* shaped pill around the number */
    margin-left: 0.35rem;
    padding: 0 0.45rem;
    background: var(--ink);
    color: #fff;
    border-radius: 9999px;
  }
  /* Active chip is already black — invert the pill to keep the count legible. */
  .chip.is-active .chip__n {
    background: #fff;
    color: var(--ink);
  }

  /* Sort row shares the same two-column grid — no special casing. */
  .filters__label {
    font-size: var(--f6);
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .chip--sort {
    font-family: var(--font-display); /* Departure Mono — chrome voice */
    font-size: var(--f6);
    background: transparent;
    border-color: var(--line);
  }
  .chip--sort:hover {
    border-color: var(--line-strong);
  }
  .chip--sort.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .chip__dir {
    display: inline-block;
    min-width: 0.75em;
  }
  .chip--random {
    margin-left: auto; /* park the dice at the far end of the row */
    border-color: var(--line-strong);
  }
  .chip--random:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* The dense index: year, title, client. */
  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .row {
    border-bottom: 1px solid var(--line);
  }
  .row__brief {
    display: none;
  }
  .row__link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 0;
    font-size: var(--f5);
  }
  .row__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  /* Tablet: two columns — text block (title, date, client, brief) beside
     the image. Distinct from both the mobile stack and the desktop
     hover-preview row below. */
  @media (min-width: 48rem) and (max-width: 79.99rem) {
    .row__link {
      display: flex;
      flex-direction: row-reverse;
      gap: 1.5rem;
      align-items: flex-start;
    }
    .row__thumb {
      flex: 0 0 14rem;
      margin-bottom: 0;
      height: auto;
      aspect-ratio: 4 / 3;
    }
    .row__text {
      flex: 1;
    }
    .row__brief {
      display: block;
      margin-top: 0.3rem;
      color: var(--ink-soft);
      font-size: var(--f6);
    }
  }
  @media (min-width: 80rem) {
    .row__link {
      display: block;
    }
    .row__text {
      display: grid;
      grid-template-columns: 5rem 1fr 14rem;
      gap: 1.5rem;
      align-items: baseline;
    }
  }
  .row__year {
    color: var(--ink-faint);
    font-size: var(--f6);
  }
  /* Row highlight on hover — the whole band, not just the title. */
  @media (hover: hover) {
    .row__link {
      transition: background 0.15s ease;
    }
    .row__link:hover {
      background: var(--surface);
    }
  }
  .row__link:hover .row__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .row__client {
    color: var(--ink-soft);
    font-size: var(--f6);
  }
  /* Inline thumb on touch/small screens; hidden where the cursor
     preview takes over. */
  .row__thumb {
    display: block;
    width: 100%;
    height: 10rem;
    object-fit: cover;
    object-position: top;
    margin-bottom: 0.5rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .row__thumb {
      display: none;
    }
  }

  .cta {
    margin-top: 2.5rem;
  }
  .cta__text {
    margin: 0 0 0.35rem;
    font-size: var(--f3);
    line-height: 1.25;
  }
  .cta__link {
    font-size: var(--f5);
  }
</style>
