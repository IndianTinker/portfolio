---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<Base title="Projects — Rohit Gupta">
  <section class="wrap">
    <h1 class="page-head">Projects</h1>
    <div class="list">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Base>

<style>
  .page-head {
    font-size: 1.5rem; /* f3 (mobile) */
    line-height: 1.25;
    margin: 0 0 clamp(1.5rem, 5vw, 3rem);
    padding-top: 2rem; /* 32px above the page title */
  }
  @media (min-width: 30em) {
    .page-head {
      font-size: 5rem; /* f-subheadline-ns, matching About */
    }
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
</style>
